# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# In CI and EAS builds these come from EAS Secrets (ADR-0003).
#
# NOTE: the PRIMARY weather provider (Open-Meteo) requires NO API key — it
# serves forecast, historical, air quality, and geocoding without one
# (ADR-0002). Only the services below need credentials, and none of them
# guards the primary weather data path.

# OpenWeather One Call 3.0 — severe weather alerts + resilience fallback
OPENWEATHER_API_KEY=

# Mapbox — map tiles (Phase 8)
# IMPORTANT: the public token MUST be URL-restricted to the app's bundle IDs.
# An unrestricted Mapbox token is a billing incident waiting to happen (ADR-0003).
MAPBOX_ACCESS_TOKEN=
MAPBOX_DOWNLOAD_TOKEN=

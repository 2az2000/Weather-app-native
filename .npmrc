# Peer-dependency resolution is relaxed because three versions are deliberately
# pinned (CLAUDE.md §37) and their peer ranges have not caught up:
#
#   typescript@6.0.3   — typescript-eslint HARD-ERRORS on TS 7, taking the whole
#                        lint run with it, and lint is what enforces the
#                        architecture (ADR-0007)
#   jest@29            — jest-expo@57 is built against Jest 29 internals
#   react-dom@19.2.3   — must match `react` exactly, which Expo SDK 57 pins
#
# This file exists so the EAS CLOUD BUILD works. CI passes `--legacy-peer-deps`
# on the command line, but EAS runs its own install and never sees that flag —
# it reads .npmrc. Without this, a cloud build fails at the install step, after
# the queue wait.
#
# Revisit when the pins in CLAUDE.md §37 are lifted; this should be deleted with
# the last of them.
legacy-peer-deps=true
